# Copy to .env and adjust. Every value is optional in development.

# development | testing | production
FLASK_ENV=development

# Secrets -- ALWAYS override in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me

# Database. Defaults to a local SQLite file when unset.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flask_api

# Token lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Used by `flask seed-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
